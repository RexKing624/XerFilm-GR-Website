{
  "name": "xerfilm-gr-website",
  "private": true,
  "version": "3.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "build": "node scripts/prepare-studio.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5178",
    "check:release": "node scripts/check-release.mjs",
    "test:downloads": "node scripts/test-download.mjs",
    "test:original-restore": "node --test scripts/test-original-restore-gate.mjs",
    "test:statistics": "node --test statistics/test/*.test.mjs",
    "test:photography": "node scripts/test-photography.mjs",
    "test:summary": "node --test public-summary/test/*.test.mjs",
    "test:publisher": "node --test statistics/test/publisher.test.mjs scripts/test-promotion.mjs",
    "test:seo": "node scripts/test-seo.mjs"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "5.4.21"
  },
  "license": "GPL-2.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RexKing624/XerFilm-GR-Website.git"
  }
}
