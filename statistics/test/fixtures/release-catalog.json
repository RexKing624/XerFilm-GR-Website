          "note": "\u4fdd\u7559\u4fee\u590d\u540e\u7684 27 \u6b3e\u914d\u8272\uff0c\u52a0\u5165\u9ad8\u5149\u5904\u7406\u63d0\u901f\uff1b\u4f5c\u8005\u53ca\u7528\u6237\u80f6\u7247\u5728 INFO \u663e\u793a\u5404\u81ea\u56fe\u6807\uff0c\u5e76\u652f\u6301\u76f4\u63a5\u8fdb\u5165\u56de\u653e\u65f6\u8bfb\u53d6\u5df2\u5b89\u88c5\u56fe\u6807\u3002\u5b9e\u9645\u8868\u73b0\u4ecd\u9700\u5b9e\u673a\u786e\u8ba4\u3002\u6b63\u5f0f\u7248\u4e0b\u8f7d\u4fdd\u7559\u3002",
          "standardDownload": "\u4e0b\u8f7d\u9ad8\u5149\u63d0\u901f\u4e0e INFO \u4fee\u590d\u6d4b\u8bd5\u7248 \u00b7 {revision} \u00b7 \u666e\u901a\u7248 .bin",
          "enhancedDownload": "\u4e0b\u8f7d\u9ad8\u5149\u63d0\u901f\u4e0e INFO \u4fee\u590d\u6d4b\u8bd5\u7248 \u00b7 {revision} \u00b7 \u589e\u5f3a\u7248 .bin"
        },
        "en": {
          "title": "Highlight performance & INFO icon test",
          "note": "Keeps the corrected 27 built-in looks, speeds up highlight compositing and shows installed author/user film icons in INFO, including direct playback startup. Camera testing is still required. Stable downloads remain available.",
          "standardDownload": "Download highlight & INFO test \u00b7 {revision} \u00b7 Standard .bin",
          "enhancedDownload": "Download highlight & INFO test \u00b7 {revision} \u00b7 Enhanced .bin"
        },
        "ja": {
          "title": "\u30cf\u30a4\u30e9\u30a4\u30c8\u9ad8\u901f\u5316\u30fbINFO\u4fee\u6b63\u30c6\u30b9\u30c8\u7248",
          "note": "\u4fee\u6b63\u6e08\u307f27\u7a2e\u985e\u306e\u8272\u3092\u7dad\u6301\u3057\u3001\u30cf\u30a4\u30e9\u30a4\u30c8\u51e6\u7406\u3092\u9ad8\u901f\u5316\u3002\u4f5c\u8005\u30fb\u30e6\u30fc\u30b6\u30fc\u30d5\u30a3\u30eb\u30e0\u306e\u30a2\u30a4\u30b3\u30f3\u3092INFO\u306b\u8868\u793a\u3057\u3001\u518d\u751f\u3067\u306e\u76f4\u63a5\u8d77\u52d5\u306b\u3082\u5bfe\u5fdc\u3057\u307e\u3059\u3002\u5b9f\u6a5f\u3067\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002\u6b63\u5f0f\u7248\u3082\u5f15\u304d\u7d9a\u304d\u5229\u7528\u3067\u304d\u307e\u3059\u3002",
          "standardDownload": "\u30cf\u30a4\u30e9\u30a4\u30c8\u30fbINFO\u30c6\u30b9\u30c8\u7248 \u00b7 {revision} \u00b7 \u901a\u5e38\u7248 .bin",
          "enhancedDownload": "\u30cf\u30a4\u30e9\u30a4\u30c8\u30fbINFO\u30c6\u30b9\u30c8\u7248 \u00b7 {revision} \u00b7 \u62e1\u5f35\u7248 .bin"
        }
      }
    }
